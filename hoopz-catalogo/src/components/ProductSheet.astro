---
import Cromo from "./Cromo.astro";
import Icon from "./icons/Icon.astro";
import { getProducts } from "@/lib/catalog";

const products = getProducts();
---

<dialog data-sheet class="sheet" aria-label="Detalle del producto">
  <div data-sheet-scroll class="sheet-scroll">
    <div data-sheet-handle class="sticky top-0 z-10 flex h-12 touch-none items-center justify-center">
      <span class="h-1 w-9 rounded-full bg-faint md:hidden"></span>
      <button type="button" data-sheet-close aria-label="Cerrar" class="press absolute top-1.5 right-3 grid size-11 place-items-center rounded-full bg-surface-2">
        <Icon name="X" size={20} />
      </button>
    </div>
    <div data-sheet-body class="-mt-6"></div>
  </div>
</dialog>

{
  products.map((p) => (
    <template data-detail-template={p.slug}>
      <Cromo product={p} mode="sheet" />
    </template>
  ))
}

<style>
  .sheet {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: 100%;
    max-height: 94svh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 24px 24px 0 0;
    background: var(--color-surface);
    color: var(--color-ink);
    overflow: hidden;
    z-index: var(--z-sheet);
  }
  .sheet::backdrop {
    background: rgb(0 0 0 / 0.72);
  }
  .sheet[open]::backdrop {
    animation: backdrop-in 0.3s ease-out;
  }
  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }
  .sheet-scroll {
    max-height: 94svh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  @media (min-width: 768px) {
    .sheet {
      inset: 0;
      margin: auto;
      width: min(940px, calc(100vw - 48px));
      max-height: min(90svh, 780px);
      border-radius: 24px;
    }
    .sheet-scroll {
      max-height: min(90svh, 780px);
    }
  }
</style>
