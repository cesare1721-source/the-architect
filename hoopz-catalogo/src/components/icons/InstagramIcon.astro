---
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: cls = "" } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
  <circle cx="12" cy="12" r="4"></circle>
  <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
</svg>
