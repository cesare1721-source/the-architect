---
import * as lucide from "lucide-static";

interface Props {
  name: "Share2" | "X" | "ArrowLeft" | "ArrowDown" | "MapPin" | "Truck" | "RefreshCw" | "ChevronRight";
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls = "" } = Astro.props;
const svg = (lucide[name] as string)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/class="([^"]*)"/, `class="$1 ${cls}" aria-hidden="true" focusable="false"`);
---

<Fragment set:html={svg} />
