---
import { Picture } from "astro:assets";
import type { Product } from "@/data/schema";
import { productImage } from "@/lib/images";
import { cardImage, imageAlt, priceText, subtitle } from "@/lib/labels";

interface Props {
  product: Product;
  eager?: boolean;
}
const { product: p, eager = false } = Astro.props;
const price = priceText(p);
const legend = p.category === "retro";
---

<!-- Un casillero del vestuario: placa de cinta, luz que se enciende, prenda colgada -->
<li data-card data-category={p.category} data-slug={p.slug}>
  <a
    href={`/p/${p.slug}`}
    data-open-sheet={p.slug}
    data-soldout={p.soldOut ? "" : undefined}
    class:list={["locker press group relative block", { "is-legend": legend }]}
    style={`--accent:${p.accent}`}
  >
    <div class="locker-box relative overflow-hidden rounded-2xl border border-line">
      <div class="locker-vents h-6" aria-hidden="true"></div>
      <span data-light class="locker-light" aria-hidden="true"></span>
      <div class="relative aspect-4/5">
        <div data-glow class="locker-glow absolute inset-0" aria-hidden="true"></div>
        <span class="locker-hook" aria-hidden="true"></span>
        <div data-swing class="swing absolute inset-x-[4%] top-[5%] bottom-[2%]">
          <Picture
            src={productImage(cardImage(p))}
            alt={imageAlt(p, p.images.front ? "front" : "back")}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[320, 480, 640]}
            sizes="(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 46vw"
            class="garment h-full w-full object-contain transition-transform duration-300 ease-(--ease-out) group-hover:-translate-y-1.5"
            loading={eager ? "eager" : "lazy"}
          />
        </div>
        {legend && <span class="broadcast absolute bottom-2.5 left-2.5 rounded-full bg-gold px-2 py-1 text-[10px] text-bg">Leyenda{p.season && ` · ${p.season}`}</span>}
        {p.soldOut && <span class="broadcast absolute right-2.5 bottom-2.5 rounded-full bg-ink px-2 py-1 text-[10px] text-bg">Agotado</span>}
      </div>
    </div>
    <span class="plate" aria-hidden="true">{p.plate}</span>
    <div class="px-1 pt-3">
      <h3 class="line-clamp-2 font-sans text-[15px] leading-snug font-semibold">{p.title}</h3>
      <p class="mt-0.5 truncate text-[13px] text-muted">{subtitle(p)}</p>
      {price ? <p class="mt-1.5 font-display text-[22px] leading-none font-extrabold">{price}</p> : <p class="mt-1.5 text-[13px] font-semibold text-muted">Precio por WhatsApp</p>}
    </div>
  </a>
</li>

<style>
  .locker-box {
    background: linear-gradient(180deg, #17171c 0%, #0e0e11 100%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04);
  }
  .locker-vents {
    background:
      repeating-linear-gradient(90deg, transparent 0 7px, rgb(255 255 255 / 0.06) 7px 9px) center / 60% 10px no-repeat,
      linear-gradient(#1d1d23, #141418);
    border-bottom: 1px solid var(--color-line);
  }
  .locker-light {
    position: absolute;
    top: 1.5rem;
    left: 14%;
    right: 14%;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: var(--accent);
    box-shadow: 0 0 18px 3px color-mix(in oklch, var(--accent) 55%, transparent);
    z-index: 2;
  }
  .locker-glow {
    background: radial-gradient(ellipse 75% 65% at 50% 0%, color-mix(in oklch, var(--accent) 30%, transparent), transparent 72%);
  }
  .locker-hook {
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: 8%;
    translate: -50% 0;
    background: linear-gradient(#55555f, #2a2a30);
  }
  .swing {
    transform-origin: 50% 0;
  }
  /* Placa: cinta adhesiva con el nombre, como en un vestuario de verdad */
  .plate {
    position: absolute;
    top: 0.85rem;
    left: 50%;
    translate: -50% 0;
    rotate: -2deg;
    z-index: 3;
    padding: 0.15rem 0.55rem 0.1rem;
    background: var(--color-tape);
    color: #111;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 15px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.4);
    clip-path: polygon(2% 0, 98% 4%, 100% 96%, 1% 100%);
  }
  .is-legend .plate {
    background: var(--color-gold);
  }
  .is-legend .locker-box {
    background: linear-gradient(180deg, #1c1912 0%, #0f0e0b 100%);
  }
  .locker[data-soldout] .garment {
    filter: grayscale(0.7) drop-shadow(0 28px 26px rgb(0 0 0 / 0.65));
  }
</style>
