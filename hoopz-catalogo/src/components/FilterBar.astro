---
import { CATEGORIES, CATEGORY_LABEL } from "@/data/schema";
import { countsByCategory } from "@/lib/catalog";

const counts = countsByCategory();
const filters = [{ id: "todo", label: "Todo" }, ...CATEGORIES.map((c) => ({ id: c, label: CATEGORY_LABEL[c] }))] as const;
---

<div data-filterbar class="sticky top-(--header-h) z-(--z-sticky) -mx-4 bg-bg/90 px-4 py-3 backdrop-blur-md transition-[top] duration-250 md:-mx-6 md:px-6 xl:-mx-8 xl:px-8">
  <div role="radiogroup" aria-label="Filtrar por categoría" data-filters class="no-scrollbar flex snap-x gap-2 overflow-x-auto">
    {
      filters.map((f, i) => (
        <button
          type="button"
          role="radio"
          aria-checked={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-filter={f.id}
          class="press h-10 shrink-0 snap-start rounded-full border border-line px-4 text-sm font-semibold whitespace-nowrap transition-[background-color,color,border-color] duration-200 aria-checked:border-ink aria-checked:bg-ink aria-checked:text-bg"
        >
          {f.label} <span class="tabular-nums opacity-60">{counts[f.id]}</span>
        </button>
      ))
    }
  </div>
</div>
